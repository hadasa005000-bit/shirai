# --- בסיס נתונים (Render Postgres, נוצר אוטומטית דרך render.yaml) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Redis ל"מחוברים כעת" (Aiven) ---
# מתקבל מדף השירות ב-Aiven תחת "Connection Information"
# שימו לב: Aiven דורש TLS ולכן הכתובת מתחילה ב-rediss:// (שתי s)
REDIS_URL="rediss://default:PASSWORD@your-service-name.aivencloud.com:PORT"

# --- התחברות (NextAuth) ---
# ליצירת ערך אקראי: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="https://your-domain.com"

# --- בוט חיפוש שירים ---
# מתקבל מ-Google Cloud Console -> APIs & Services -> Credentials
# צריך להפעיל את "YouTube Data API v3" בפרויקט
YOUTUBE_API_KEY="your-youtube-api-key"

# --- משתמש מנהל ראשוני (רק לצורך seed) ---
[email protected]
SEED_ADMIN_PASSWORD="ChangeMe123!"
