generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SongStatus {
  PENDING   // נמצא ע"י הבוט, ממתין לאישור מנהל
  PUBLISHED // מוצג באתר
  HIDDEN    // הוסתר ע"י מנהל
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  favorites    Favorite[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  songs Song[]
}

model Artist {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  songs Song[]

  // שירים ששמו של האמן הזה זוהה בכותרת שלהם, בנוסף לאמן הראשי
  // (למשל מחרוזת/דואט שמופיע בכמה ערוצים ומזכיר כמה זמרים בכותרת)
  extraSongs Song[] @relation("SongExtraArtists")
}

model Song {
  id            String     @id @default(cuid())
  title         String
  artistId      String?
  artist        Artist?    @relation(fields: [artistId], references: [id])
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  youtubeId     String?
  driveLink     String?
  description   String?
  downloads     Int        @default(0)
  publishedAt   DateTime?
  lyrics        String?
  status        SongStatus @default(PENDING)
  scriptHidden  Boolean    @default(false)
  source        String     @default("manual")
  sourceUrl     String?
  views         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  favorites     Favorite[]

  // אמנים נוספים שזוהו בכותרת השיר (למשל שני זמרים באותו קליפ) —
  // בנוסף לאמן הראשי (artist), כדי שהשיר יופיע בדף של כולם ולא "יתפספס"
  extraArtists  Artist[]   @relation("SongExtraArtists")

  @@index([status])
  @@index([views])
  @@index([categoryId])
  @@index([artistId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  songId    String
  song      Song     @relation(fields: [songId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, songId])
}

model BotSource {
  id             String   @id @default(cuid())
  label          String
  type           String
  value          String
  defaultCategoryId String?
  active         Boolean  @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime @default(now())
}

model BotRunLog {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
  finishedAt DateTime?
  found     Int      @default(0)
  added     Int      @default(0)
  errors    String?
  entries   BotLogEntry[]
}

// שורת יומן בודדת — "כל מה שזז" בזמן סריקת הבוט: איזה מקור נבדק, כמה
// סרטונים נמצאו, מה נוסף, מה דולג ולמה, אילו מקורות חדשים נוצרו, ושגיאות.
// runId ריק (null) = אירוע ש"למד" מאישור שיר בודד (לא בתוך ריצת בוט
// מתוזמנת) — למשל כשמנהל מאשר שיר ידנית והמערכת יוצרת מקור בעקבותיו.
model BotLogEntry {
  id        String     @id @default(cuid())
  runId     String?
  run       BotRunLog? @relation(fields: [runId], references: [id])
  level     String     @default("info") // info | success | warn | error
  message   String
  createdAt DateTime   @default(now())

  @@index([runId])
  @@index([createdAt])
}

// ביקור יומי אחד לכל sessionId — נכתב פעם אחת ביום לכל מבקר (רשום או
// אנונימי) דרך אותו heartbeat שכבר קיים לספירת "מחוברים כעת", כדי לדעת
// כמה כניסות היו לאתר לפי יום/שבוע/חודש, כולל מבקרים לא-רשומים.
model SiteVisit {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

model AppSettings {
  id             String  @id @default("singleton")
  botAutoPublish Boolean @default(false)
}

model CategorySuggestion {
  id         String   @id @default(cuid())
  name       String   @unique
  keyword    String
  matchCount Int      @default(1)
  status     String   @default("PENDING")
  categoryId String?
  createdAt  DateTime @default(now())
}
// כל הרצה של הסקריפט המקומי (שרץ אצלכם, על המחשב עם נטפרי)
model ScriptRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  checked    Int       @default(0)
  approved   Int       @default(0)
  skipped    Int       @default(0)
  dryRun     Boolean   @default(false)
}

// יומן ביקורת: כל החלטה בודדת שהסקריפט קיבל, לצפייה ולביטול
model ScriptDecision {
  id         String   @id @default(cuid())
  runId      String
  songId     String
  title      String
  youtubeId  String?
  verdict    String   // "allowed" | "blocked_or_error"
  action     String   // "approved" | "left_pending" | "dry_run"
  reverted   Boolean  @default(false)
  createdAt  DateTime @default(now())
}
